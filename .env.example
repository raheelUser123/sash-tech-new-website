# Copy to .env.local and fill in. Never commit real keys.

# Public site URL used for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sashtech.digital

# Public contact address shown on the site and used for mailto: fallbacks
# (defaults to info@sashtech.digital).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Contact, meeting and newsletter forms (POST /api/contact) -------------

# Server-only SMTP settings for contact, partner, meeting and newsletter notifications and customer acknowledgements.
# Use your Sash Tech mailbox credentials. Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Notification recipients. Comma-separate multiple addresses.
# Falls back to CONTACT_TO_EMAIL, then NEXT_PUBLIC_CONTACT_EMAIL.
ADMIN_EMAIL=
CONTACT_TO_EMAIL=

# Optional sender override; defaults to "Sash Tech Digital" <SMTP_USER>.
CONTACT_FROM_EMAIL=

# --- Meeting booking (/contact/schedule) ------------------------------------
# Optional Calendly / Cal.com link. When set, the booking page shows a
# "Prefer Calendly?" link next to the built-in date & time picker.
NEXT_PUBLIC_BOOKING_URL=


# Required CAPTCHA for ALL forms. Create a managed Turnstile widget for sashtech.digital.
# Set these BEFORE building; never use Cloudflare test keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Keep disabled to prevent public forms from sending automatic emails to arbitrary addresses.
CONTACT_SEND_ACKNOWLEDGEMENTS=false
